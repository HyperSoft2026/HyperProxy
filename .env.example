# Clever Cloud provides this after linking a PostgreSQL add-on.
POSTGRESQL_ADDON_URI=

# Required bootstrap SOCKS5 account. Use a unique password of at least 16 characters.
PROXY_ADMIN_USERNAME=hypersoft-admin
PROXY_ADMIN_PASSWORD=CHANGE_THIS_TO_A_PRIVATE_ADMIN_SECRET

# Separate public SOCKS5-only account. Share only these credentials in the Telegram proxy link.
# Keep different from the administrator username and password.
PROXY_PUBLIC_USERNAME=hyperSoft
PROXY_PUBLIC_PASSWORD=CHANGE_THIS_TO_A_PUBLIC_PROXY_SECRET

# Public Clever Cloud TCP redirection remains on internal port 4040.
# Legacy SOCKS_HOST/SOCKS_PORT, if already configured, still refer to this public listener.
ROUTER_HOST=0.0.0.0
ROUTER_PORT=4040
SOCKS_BACKEND_HOST=127.0.0.1
SOCKS_BACKEND_PORT=4041
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# PostgreSQL pool is intentionally small for low connection-limit plans.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=3
DB_POOL_IDLE_SECONDS=60

# Optional MTProto support. Generate once with: openssl rand -hex 16
# Keep the same secret across deployments. Do not set the tag until @MTProxyBot gives it to you.
MTPROTO_SECRET=
MTPROTO_PROXY_TAG=
MTPROTO_PORT=4042
MTPROTO_STATS_PORT=8888
MTPROTO_WORKERS=1

# SOCKS5 is restricted to Telegram's published server networks and these destination ports.
# Source: https://core.telegram.org/resources/cidr.txt
# Leave TELEGRAM_ALLOWED_CIDRS unset to use the built-in official CIDR list.
ALLOWED_PORTS=80,443,5222
TELEGRAM_ALLOWED_CIDRS=
MAX_CONNECTIONS=200
MAX_CONNECTIONS_PER_USER=20
CONNECT_TIMEOUT_SECONDS=10
AUTH_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
